# Netlify environment variables for AQTK AI chat
OPENAI_API_KEY=your_openai_api_key_here
# Optional: any OpenAI-compatible provider. Default: https://api.openai.com/v1
# Free tier (Groq): OPENAI_BASE_URL=https://api.groq.com/openai/v1 + OPENAI_MODEL=llama-3.3-70b-versatile
# Google Gemini:    OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OpenRouter:       OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
